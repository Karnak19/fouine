{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "bun"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "~/*": [
        "../server/src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
