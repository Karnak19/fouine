{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "outputs": ["dist/**", ".vitepress/dist/**"]
    },
    "typecheck": {},
    "test": {},
    "dev": {
      "cache": false,
      "persistent": true,
      // Turbo's env mode is strict: anything not listed here never reaches the
      // server process, so `CHAT_MOCK=1 bun run dev` would silently do nothing.
      "passThroughEnv": ["CHAT_MOCK"]
    }
  }
}
