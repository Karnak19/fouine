{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "outputs": ["dist/**", ".vitepress/dist/**"]
    },
    "typecheck": {},
    "test": {},
    "dev": {
      "cache": false,
      "persistent": true,
      // Turbo's env mode is strict: anything not listed here never reaches the
      // server process, so `CHAT_MOCK=1 bun run dev` would silently do nothing.
      // `OPENCODE_API_KEY` is the upstream credential and `LOG_LEVEL` gates the
      // debug lines; both were being stripped by the same default.
      "passThroughEnv": ["CHAT_MOCK", "OPENCODE_API_KEY", "LOG_LEVEL"]
    }
  }
}
