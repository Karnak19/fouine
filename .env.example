# fouine configuration. Copy to .env and fill in.

# --- Server ---
PORT=3000
# Log level: debug | info (default) | warn | error. Use debug to see why a
# webhook handler early-returned (e.g. a /review that didn't fire).
LOG_LEVEL=info
# --- Dashboard login (GitHub OAuth) ---
# Protects the dashboard and /api. Login is DISABLED unless BETTER_AUTH_SECRET,
# GITHUB_APP_CLIENT_ID and GITHUB_APP_CLIENT_SECRET are all set. /webhook/github
# and /health are always exempt.
# Random string used to sign sessions: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Public origin of the app, e.g. https://fouine.example.com (no trailing slash).
# Defaults to http://localhost:$PORT for local dev.
BETTER_AUTH_URL=
# Comma-separated GitHub usernames allowed to sign in (case-insensitive).
# Anyone not listed is rejected at first sign-in. Leave empty to allow no one.
ALLOWED_GITHUB_USERS=

# --- GitHub App ---
# Required to receive webhooks and post reviews.
GITHUB_APP_ID=
# Paste the private key with literal \n (fouine un-escapes them), OR use the
# *_PATH variant below and mount the .pem file instead (recommended).
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
# OAuth credentials of the SAME App (General > Client ID / generate a secret),
# reused for dashboard login. Requires callback URL
# $BETTER_AUTH_URL/api/auth/callback/github and Account permission
# "Email addresses: read-only" (GitHub Apps derive email from permissions).
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# --- OpenCode (model provider) ---
# opencode-go API key. Injected into the in-process opencode server at review
# time via auth.set, so it works on any host without a local opencode auth store.
OPENCODE_API_KEY=
# Optional: override the default model "opencode-go/deepseek-v4-flash".
OPENCODE_MODEL=opencode-go/deepseek-v4-flash
# Ceiling on the bash timeout the *model* asks for. opencode lets the model pass
# any `timeout` and, when a command is killed, tells it to "retry with a larger
# timeout" — so one wedged command escalates until the whole review dies. This
# clamps it. NOT FOUINE_-prefixed on purpose: those keys are purged before each
# opencode spawn, so a FOUINE_ name here would be silently dropped.
OPENCODE_BASH_TIMEOUT_MAX_MS=120000

# --- Review watchdogs ---
# The real "wedged, kill it" rule: no event from opencode for this long. Elapsed
# time can't tell a slow review from a stuck one; silence can. Generous on
# purpose — a model can reason, or run one quiet command, for minutes.
REVIEW_IDLE_TIMEOUT_MS=300000
# Absolute backstop. Reaching it means something is looping while still emitting
# events, which the idle rule above cannot see. Keep it tight until you've
# watched real durations; it is the only cutoff for that failure mode.
REVIEW_TIMEOUT_MS=2700000
# Cap on the dependency install fouine runs before each review. On timeout the
# review continues without node_modules rather than failing.
REVIEW_INSTALL_TIMEOUT_MS=300000

# --- AI observability (PostHog, optional) ---
# Leave POSTHOG_API_KEY empty and the feature is entirely absent: the plugin is
# never declared, downloaded, or run. See the README for the caveat that a hung
# tool call reports no event at all.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# true drops prompts, completions and tool IO; keeps tokens, cost, latency, model.
POSTHOG_PRIVACY_MODE=false
